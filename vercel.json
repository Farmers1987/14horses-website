{
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "site",
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(?<sub>.*)\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/category/(.*)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/category",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/product-category/(.*)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/product-category",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/product/(.*)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/product",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/shop/(.*)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/shop",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/cart/(.*)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/cart",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/checkout/(.*)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/checkout",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/my-account/(.*)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/my-account",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/tag/(.*)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/tag",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/(.*)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ru/(.*)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ru",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/lt/(.+)",
      "destination": "/lt/",
      "permanent": true
    },
    {
      "source": "/kategorija/(.*)",
      "destination": "/lt/",
      "permanent": true
    },
    {
      "source": "/kategorija",
      "destination": "/lt/",
      "permanent": true
    },
    {
      "source": "/parduotuve/(.*)",
      "destination": "/lt/",
      "permanent": true
    },
    {
      "source": "/parduotuve",
      "destination": "/lt/",
      "permanent": true
    },
    {
      "source": "/produktas/(.*)",
      "destination": "/lt/",
      "permanent": true
    },
    {
      "source": "/produktas",
      "destination": "/lt/",
      "permanent": true
    }
  ]
}